{
  "name": "pace",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^2.4.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.8",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-security": "^4.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "sql.js": "^1.15.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "wait-on": "^9.5.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "build:android:local": "npx expo run:android --variant release",
    "desktop": "npm run desktop:export && node desktop/launch.js",
    "desktop:dev": "concurrently -k -n expo,electron -c blue,magenta \"expo start --port 8081\" \"wait-on -t 180000 http-get://localhost:8081 && node desktop/launch.js --dev\"",
    "desktop:export": "expo export --platform web --clear",
    "desktop:pack": "npm run desktop:export && node desktop/stage.js && electron-builder --config desktop/electron-builder.json --dir",
    "desktop:dist": "npm run desktop:export && node desktop/stage.js && electron-builder --config desktop/electron-builder.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "audit": "npm audit --omit=dev",
    "security": "npm run lint && npm run audit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.tsx"
    ],
    "coverageThreshold": {
      "global": { "lines": 75, "statements": 75, "functions": 75, "branches": 75 }
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*-test.[jt]s?(x)"
    ]
  }
}
